# Copy to .env (never commit .env). All values are optional; defaults shown.
# Database: SQLite (zero-install dev) by default. PostgreSQL example:
#   CAUSALX_DATABASE_URL=postgresql+psycopg://causalx:change-me@localhost:5432/causalx   (needs: pip install "psycopg[binary]")
# CAUSALX_DATABASE_URL=sqlite:///data/causalx.db
# CAUSALX_DATA_DIR=./data
# CAUSALX_ARTIFACTS_DIR=./artifacts
CAUSALX_N_CUSTOMERS=40000
CAUSALX_SEED=42
CAUSALX_MAX_UPLOAD_MB=50
CAUSALX_LOG_LEVEL=INFO
CAUSALX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
